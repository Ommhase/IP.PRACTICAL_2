# Question 10: Error Analysis in Expressions
# ==========================================================
print("\n--- Question 10 ---")
# Division by zero handling
try:
    num_a = int(input("Enter a number: "))
    num_b = int(input("Enter divisor: "))
    print("Result:", num_a / num_b)
except ZeroDivisionError:
    print("Error: Division by zero is not allowed.")

# String + number handling
try:
    s = "10"
    n = 5
    print(s + n)
except TypeError:
    print("Error: Cannot concatenate string and integer directly.")
    print("Correct Way (casting):", int(s) + n)


