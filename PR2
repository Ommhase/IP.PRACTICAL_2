# ==========================================================
# Question 4: Operator Precedence Analysis
# ==========================================================
print("\n--- Question 4 ---")
# Precedence: * and / have higher priority than + and -
print("10 + 5 * 2       =", 10 + 5 * 2)          # 10 + 10 = 20
print("(10 + 5) * 2     =", (10 + 5) * 2)        # 15 * 2 = 30
print("100 / 5 + 3 * 2  =", 100 / 5 + 3 * 2)     # 20.0 + 6 = 26.0


