# --- Q4: Operator Precedence Analysis ---
print("Q4 -> 10 + 5 * 2 =", 10 + 5 * 2)
print("Q4 -> (10 + 5) * 2 =", (10 + 5) * 2)
print("Q4 -> 100 / 5 + 3 * 2 =", 100 / 5 + 3 * 2)

# --- Q5: Salary Breakdown ---
basic = float(input("Q5 Enter Basic Salary: "))
hra = basic * 0.20
da = basic * 0.10
net_salary = basic + hra + da
print(f"Q5 -> Basic: {basic}, HRA: {hra}, DA: {da}, Net Salary: {net_salary}")

# --- Q6: Area and Perimeter Calculator ---
length, width = 10, 5
radius = 7
rect_area = length * width
rect_peri = 2 * (length + width)
circ_area = 3.14159 * (radius ** 2)
circ_peri = 2 * 3.14159 * radius
print(f"Q6 Rectangle -> Area: {rect_area}, Perimeter: {rect_peri}")
print(f"Q6 Circle -> Area: {circ_area:.2f}, Circumference: {circ_peri:.2f}")

