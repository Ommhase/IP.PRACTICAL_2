# ==========================================================
# Question 9: Expression-Based Grading System
# ==========================================================
print("\n--- Question 9 ---")
m1 = float(input("Enter marks of subject 1: "))
m2 = float(input("Enter marks of subject 2: "))
m3 = float(input("Enter marks of subject 3: "))

total = m1 + m2 + m3
percentage = total / 3

if percentage >= 90:
    grade = "A+"
elif percentage >= 80:
    grade = "A"
elif percentage >= 70:
    grade = "B"
elif percentage >= 60:
    grade = "C"
elif percentage >= 40:
    grade = "D"
else:
    grade = "Fail"

print(f"Total Marks : {total:.2f}")
print(f"Percentage  : {percentage:.2f}%")
print(f"Grade       : {grade}")


