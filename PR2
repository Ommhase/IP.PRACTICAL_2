            <p>Machines performing tasks that need human intelligence.</p>
        </section>

        <section id="cloud">
            <h2>Cloud Computing</h2>
            <p>Computing services delivered over the internet.</p>
        </section>

        <section id="cyber">
            <h2>Cyber Security</h2>
            <p>Protecting computers, networks and information.</p>
        </section>

        <section id="iot">
            <h2>Internet of Things</h2>
            <p>Connected devices collect and exchange data.</p>
        </section>

        <section id="technology-table">
            <h2>Technology Information</h2>
            <table border="1" cellpadding="8" cellspacing="0">
                <thead>
                    <tr>
                        <th>Technology</th>
